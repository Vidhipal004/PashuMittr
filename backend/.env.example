PORT=8787
CORS_ORIGIN=*
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Current BHASHINI / Dhruva inference API credentials (keep server-side)
BHASHINI_INFERENCE_API_KEY=
BHASHINI_USER_ID=
# Optional legacy ULCA discovery credentials if your account provides them
BHASHINI_ULCA_API_KEY=
BHASHINI_PIPELINE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
# Set service IDs supplied by your BHASHINI account for each locale
BHASHINI_TTS_SERVICE_ID_HI=
BHASHINI_TTS_SERVICE_ID_MR=
BHASHINI_TTS_SERVICE_ID_GU=
BHASHINI_TTS_SERVICE_ID_PA=
BHASHINI_TTS_SERVICE_ID_BN=
BHASHINI_TTS_SERVICE_ID_TE=
BHASHINI_TTS_SERVICE_ID_TA=
BHASHINI_TTS_SERVICE_ID_KN=
BHASHINI_TTS_SERVICE_ID_ML=
BHASHINI_TTS_SERVICE_ID_OR=
BHASHINI_TTS_SERVICE_ID_AS=
BHASHINI_ASR_SERVICE_ID_HI=
BHASHINI_ASR_SERVICE_ID_MR=
BHASHINI_ASR_SERVICE_ID_GU=
BHASHINI_ASR_SERVICE_ID_PA=
BHASHINI_ASR_SERVICE_ID_BN=
BHASHINI_ASR_SERVICE_ID_TE=
BHASHINI_ASR_SERVICE_ID_TA=
BHASHINI_ASR_SERVICE_ID_KN=
BHASHINI_ASR_SERVICE_ID_ML=
BHASHINI_ASR_SERVICE_ID_OR=
BHASHINI_ASR_SERVICE_ID_AS=
BHASHINI_ASR_SERVICE_ID_EN=

# Optional Google Cloud Text-to-Speech (TTS)
# Enable Cloud Text-to-Speech in your Google Cloud project. For hackathon use you may supply an API key or a short-lived OAuth access token.
GOOGLE_CLOUD_TTS_API_KEY=
GOOGLE_CLOUD_ACCESS_TOKEN=
GOOGLE_CLOUD_TTS_ENDPOINT=https://texttospeech.googleapis.com/v1/text:synthesize
# Optional voice-name overrides. Leave blank to let the API choose by locale where supported.
GOOGLE_TTS_VOICE_EN=en-IN-Standard-A
GOOGLE_TTS_VOICE_HI=hi-IN-Standard-A
GOOGLE_TTS_VOICE_MR=mr-IN-Wavenet-A
GOOGLE_TTS_VOICE_GU=gu-IN-Standard-A
GOOGLE_TTS_VOICE_PA=
GOOGLE_TTS_VOICE_BN=
GOOGLE_TTS_VOICE_TE=te-IN-Standard-A
GOOGLE_TTS_VOICE_TA=ta-IN-Standard-A
GOOGLE_TTS_VOICE_KN=kn-IN-Standard-A
GOOGLE_TTS_VOICE_ML=ml-IN-Standard-A
GOOGLE_TTS_VOICE_OR=
GOOGLE_TTS_VOICE_AS=

# Notes: keep all API keys server-side. Do not put cloud credentials in frontend code.

# ElevenLabs voice (server-side only)
ELEVENLABS_API_KEY=
# Optional 2nd key: used automatically if key 1 hits 401/402/429 (quota)
ELEVENLABS_API_KEY_2=
# Two voices: English text -> EN voice, Hindi/other Indian languages -> HI voice
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_HI=
# Fallback if the two above are blank
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# eleven_flash_v2_5 = lowest latency (supports Hindi); eleven_multilingual_v2 = best quality
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2

# Authentication — Twilio Verify (recommended for demo / production-style OTP)
# Create a Verify Service in Twilio Console and put the credentials below in backend/.env
AUTH_PROVIDER=twilio
# Judge-safe demo path: this special 10-digit demo value never contacts Twilio.
# The frontend shows it beside the mobile field. Change only if you need a different demo marker.
DEMO_AUTH_ENABLED=true
DEMO_PHONE=0000000000
DEMO_OTP=123456
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_VERIFY_CHANNEL=sms
# Optional: override only for local integration tests. Leave blank for Twilio's public endpoint.
TWILIO_VERIFY_BASE_URL=https://verify.twilio.com/v2
# Only used when AUTH_PROVIDER=demo
DEMO_OTP=123456
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30

# Farmer assistant (v34): hedged cascade. First model starts immediately; if it has not answered
# in GEMINI_HEDGE_MS the next model is started in parallel. First good answer wins.
GEMINI_ASSISTANT_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.7-flash,gemini-2.5-flash-lite,gemini-2.5-flash
GEMINI_REQUEST_TIMEOUT_MS=9000
GEMINI_HEDGE_MS=2500
GEMINI_TOTAL_TIMEOUT_MS=28000
